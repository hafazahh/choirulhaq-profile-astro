/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  # CSP for the floating anchor ad (AdSense). Astro keeps every inline script
  # hoisted into /_astro/*.js, so 'self' alone is still enough for the site —
  # these additions are only the origins the ad itself needs:
  #   script-src: pagead2 (loader), tpc.googlesyndicate (ad delivery),
  #               partner.googleadservices + googletagservices (creatives)
  #   img-src   : ad images and tracking pixels are not same-origin
  #   frame-src : some formats render inside an iframe (denied when omitted)
  #   connect-src: ad measurement and verification calls
  # frame-ancestors stays 'none' — that direction frames the PAGE out, and is
  # unrelated to the ad's own child iframe, which is frame-src.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://partner.googleadservices.com https://www.googletagservices.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://ui-avatars.com https://pagead2.googlesyndication.com https://tpc.googlesyndication.com https://www.google.com https://googleusercontent.com; font-src 'self' data:; connect-src 'self' https://pagead2.googlesyndication.com https://tpc.googlesyndication.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Astro fingerprints the filenames it builds into /_astro/, so those URLs
# change whenever the content does and can be cached forever. That is the
# safe place for `immutable`.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/*.webmanifest
  Cache-Control: public, max-age=3600

# Files served from a STABLE name — floating-ad.js being the one that motivated
# this — must be revalidated instead of cached for a year. `immutable` on a
# stable path means an edit is invisible to every visitor who already loaded it
# until the cache expires (observed: age 3434s on a 31536000s max-age), and a
# page reference alone cannot fix it. no-cache keeps the fast path (the edge
# still serves a 304) while guaranteeing a fresh copy is eventually seen.
/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.css
  Cache-Control: public, max-age=3600

# HTML is what tells the browser which JS to load, so it must never go stale.
/*
  Cache-Control: public, max-age=0, must-revalidate
