---
import { getLangFromUrl, t, type Lang } from "../i18n";

const lang: Lang = getLangFromUrl(Astro.url);
---

<section id="tentang" class="py-20 px-4 max-w-4xl mx-auto">
  <h2 class="text-3xl md:text-4xl font-bold text-center mb-8 text-purple-900">
    {t(lang, "about.title")}
  </h2>
  <div class="flex flex-col md:flex-row items-center gap-8">
    <img
      src="https://ui-avatars.com/api/?name=Choirul+Haq&size=200&background=c4b5fd&color=5b21b6"
      alt="Foto profil Choirul Haq"
      width="200"
      height="200"
      loading="lazy"
      class="w-48 h-48 rounded-full shadow-lg"
    />
    <div class="text-lg text-gray-700 leading-relaxed">
      <p class="mb-4">{t(lang, "about.p1")}</p>
      <p class="mb-4">{t(lang, "about.p2")}</p>
      <p>{t(lang, "about.p3")}</p>
    </div>
  </div>
</section>
