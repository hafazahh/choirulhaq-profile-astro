---
import { getLangFromUrl, t, type Lang } from "../i18n";

const lang: Lang = getLangFromUrl(Astro.url);

const tutorials = [
  {
    titleKey: "tutorial.items.python.title",
    descKey: "tutorial.items.python.desc",
    icon: "🐍",
    topics: ["Dasar Python", "OOP", "Web Framework", "Data Science", "Machine Learning"],
    link: "/python#dasar",
    topicLinks: {
      "OOP": "/python#oop",
      "Web Framework": "/python#web",
      "Data Science": "/python#data",
      "Machine Learning": "/python#ml",
    },
  },
  {
    titleKey: "tutorial.items.java.title",
    descKey: "tutorial.items.java.desc",
    icon: "☕",
    topics: ["Dasar Java", "OOP", "Spring Boot", "Database"],
    link: "/java#dasar",
    topicLinks: {
      "OOP": "/java#oop",
      "Spring Boot": "/java#spring",
      "Database": "/java#database",
    },
  },
  {
    titleKey: "tutorial.items.sqlserver.title",
    descKey: "tutorial.items.sqlserver.desc",
    icon: "🗄️",
    topics: ["DDL & DML", "Join", "Stored Procedure", "Backup & Restore"],
    link: "/sqlserver#ddl",
    topicLinks: {
      "Join": "/sqlserver#join",
      "Stored Procedure": "/sqlserver#procedure",
      "Backup & Restore": "/sqlserver#backup",
    },
  },
  {
    titleKey: "tutorial.items.networking.title",
    descKey: "tutorial.items.networking.desc",
    icon: "🌐",
    topics: ["Cisco Packet Tracer", "PNETLab", "Routing & Switching", "Network Security"],
    link: "/networking#cisco",
    topicLinks: {
      "PNETLab": "/networking#pnetlab",
      "Routing & Switching": "/networking#routing",
      "Network Security": "/networking#security",
    },
  },
  {
    titleKey: "tutorial.items.hacking.title",
    descKey: "tutorial.items.hacking.desc",
    icon: "🔐",
    topics: ["Network Security", "Penetration Testing", "Web Security", "Forensics"],
    link: "/hacking#network",
    topicLinks: {
      "Penetration Testing": "/hacking#pentest",
      "Web Security": "/hacking#web",
      "Forensics": "/hacking#forensics",
    },
  },
];
---

<section id="tutorial" class="py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-purple-900">
      {t(lang, "tutorial.title")}
    </h2>
    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
      {tutorials.map((tutorial) => (
        <li class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition border border-gray-100">
          {tutorial.link ? (
            <a href={tutorial.link} class="block">
              <div class="text-4xl mb-3" aria-hidden="true">{tutorial.icon}</div>
              <h3 class="text-xl font-bold mb-2 text-purple-800">{t(lang, tutorial.titleKey)}</h3>
              <p class="text-gray-600 text-sm mb-3">{t(lang, tutorial.descKey)}</p>
              <ul class="space-y-1">
                {tutorial.topics.map((topic) => (
                  <li class="text-purple-700 font-medium text-sm">
                    {tutorial.topicLinks?.[topic] ? (
                      <a href={tutorial.topicLinks[topic]} class="hover:underline">• {topic}</a>
                    ) : (
                      <>• {topic}</>
                    )}
                  </li>
                ))}
              </ul>
            </a>
          ) : (
            <>
              <div class="text-4xl mb-3" aria-hidden="true">{tutorial.icon}</div>
              <h3 class="text-xl font-bold mb-2 text-purple-800">{t(lang, tutorial.titleKey)}</h3>
              <p class="text-gray-600 text-sm mb-3">{t(lang, tutorial.descKey)}</p>
              <ul class="space-y-1">
                {tutorial.topics.map((topic) => (
                  <li class="text-purple-700 font-medium text-sm">• {topic}</li>
                ))}
              </ul>
            </>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
