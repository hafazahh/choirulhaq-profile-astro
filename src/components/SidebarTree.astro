---
import { TREE, BADGE, type Kind } from "../data/pythonTree";

/**
 * Sidebar tree materi Python.
 *
 * Aturan tampilan mengikuti mockup: bab bisa dibuka-tutup, daun menampilkan
 * badge sesuai jenis materi. Item bertanda `segera` dirender sebagai teks
 * biasa, bukan tautan — supaya pembaca tidak mengklik jalan buntu.
 *
 * Navigasi memakai hash (#variabel-dan-tipe-data-python) sehingga setiap
 * artikel tetap punya URL sendiri yang bisa diindeks Google, sementara
 * halaman tetap terasa seperti satu aplikasi.
 */

interface Props {
  activeSlug?: string;
  activeSection?: string;
}

const { activeSlug, activeSection } = Astro.props;
---

<nav class="tree" aria-label="Indeks materi Python">
  {
    TREE.map((section) => {
      const open = activeSection === section.id;
      return (
        <section class:list={["tree__section", { "tree__section--open": open }]}>
          <h3 class="tree__head">
            <button
              type="button"
              class="tree__toggle"
              aria-expanded={open ? "true" : "false"}
              data-section={section.id}
            >
              <span class="tree__chevron" aria-hidden="true">›</span>
              {section.label}
            </button>
          </h3>
          <ul class="tree__list" data-list={section.id} hidden={!open}>
            {section.items.map((item) => {
              const soon = item.kind === "segera";
              const badge = BADGE[item.kind];
              const isActive = item.slug && item.slug === activeSlug;
              const Tag = soon ? "span" : "a";
              return (
                <li>
                  <Tag
                    class:list={[
                      "tree__item",
                      { "tree__item--soon": soon, "tree__item--active": !!isActive },
                    ]}
                    {...(soon ? {} : { href: `#${item.slug}` })}
                    {...(soon ? { "aria-disabled": "true" } : {})}
                  >
                    <span class="tree__label">{item.label}</span>
                    {badge && <span class={`badge badge--${item.kind}`}>{badge}</span>}
                  </Tag>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })
  }
</nav>

<style>
  .tree {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .tree__head {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  .tree__toggle {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    width: 100%;
    padding: 0.4rem 0.6rem;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--py-text-secondary);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }
  .tree__toggle:hover {
    background: var(--py-accent-soft);
    color: var(--py-accent);
  }

  .tree__chevron {
    display: inline-block;
    transition: transform 0.2s ease;
    font-size: 0.7rem;
    color: var(--py-text-secondary);
  }
  .tree__section--open .tree__chevron {
    transform: rotate(90deg);
  }

  .tree__list {
    list-style: none;
    margin: 0.0625rem 0 0.375rem 0.85rem;
    padding: 0;
    border-left: 1px solid var(--py-border);
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
  }

  .tree__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    color: var(--py-text);
    font-size: 0.875rem;
    text-decoration: none;
    line-height: 1.35;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .tree__item:hover {
    background: var(--py-accent-soft);
    color: var(--py-accent);
  }
  .tree__item--active {
    background: var(--py-accent-soft);
    color: var(--py-accent);
    font-weight: 600;
  }
  .tree__item--soon {
    color: var(--py-text-secondary);
    cursor: default;
    opacity: 0.75;
  }
  .tree__item--soon:hover {
    background: transparent;
    color: var(--py-text-secondary);
  }

  .tree__label {
    flex: 1;
  }

  /* Badge: warna tenang, cukup membedakan jenis materi tanpa berisik. */
  .badge {
    flex-shrink: 0;
    font-size: 0.65rem;
    font-weight: 600;
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    letter-spacing: 0.01em;
  }
  .badge--artikel {
    background: var(--py-accent-soft);
    color: var(--py-accent);
  }
  .badge--panduan {
    background: rgba(16, 185, 129, 0.12);
    color: #047857;
  }
  .badge--latihan {
    background: rgba(245, 158, 11, 0.14);
    color: #b45309;
  }

  @media (prefers-color-scheme: dark) {
    .badge--panduan {
      color: #6ee7b7;
    }
    .badge--latihan {
      color: #fbbf24;
    }
  }

  /* Di layar sempit sidebar jadi panel geser; badge rapat supaya tak kepotong. */
  @media (max-width: 860px) {
    .tree__item,
    .tree__toggle {
      padding: 0.5rem 0.7rem;
      font-size: 0.9rem;
    }
    .badge {
      font-size: 0.6rem;
    }
  }
</style>

<script>
  // Buka-tutup bab. Keadaan awal dari server (bab aktif sudah terbuka);
  // script ini hanya menangani interaksi setelah halaman tampil.
  document.querySelectorAll<HTMLButtonElement>(".tree__toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.section;
      if (!id) return;
      const list = document.querySelector(`[data-list="${id}"]`);
      const section = btn.closest(".tree__section");
      if (!list || !section) return;
      const willOpen = list.hasAttribute("hidden");
      list.toggleAttribute("hidden", !willOpen);
      section.classList.toggle("tree__section--open", willOpen);
      btn.setAttribute("aria-expanded", willOpen ? "true" : "false");
    });
  });
</script>