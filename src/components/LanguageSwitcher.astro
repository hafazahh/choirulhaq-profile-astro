---
---

<div class="fixed top-4 right-4 z-50 flex gap-2">
  <button
    data-lang-btn="id"
    class="lang-btn cursor-pointer flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-medium shadow-md transition bg-white text-purple-700 hover:bg-purple-50"
  >
    <svg width="16" height="12" viewBox="0 0 16 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="16" height="6" fill="#FF0000"/>
      <rect y="6" width="16" height="6" fill="#FFFFFF"/>
    </svg>
    <span>ID</span>
  </button>
  <button
    data-lang-btn="en"
    class="lang-btn cursor-pointer flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-medium shadow-md transition bg-white text-purple-700 hover:bg-purple-50"
  >
    <svg width="16" height="12" viewBox="0 0 16 12" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect width="16" height="12" fill="#B22234"/>
      <rect y="1" width="16" height="1" fill="#FFFFFF"/>
      <rect y="3" width="16" height="1" fill="#FFFFFF"/>
      <rect y="5" width="16" height="1" fill="#FFFFFF"/>
      <rect y="7" width="16" height="1" fill="#FFFFFF"/>
      <rect y="9" width="16" height="1" fill="#FFFFFF"/>
      <rect y="11" width="16" height="1" fill="#FFFFFF"/>
      <rect width="7" height="6" fill="#3C3B6E"/>
    </svg>
    <span>EN</span>
  </button>
</div>

<script>
  import { dictionaries } from "../i18n/dictionaries";

  function getLang() {
    return localStorage.getItem("lang") === "en" ? "en" : "id";
  }

  function applyLang(lang) {
    document.querySelectorAll("[data-i18n]").forEach((el) => {
      const key = el.getAttribute("data-i18n");
      if (key && dictionaries[lang][key]) {
        el.textContent = dictionaries[lang][key];
      }
    });
    document.documentElement.lang = lang;
    document.querySelectorAll("[data-lang-btn]").forEach((btn) => {
      const isActive = btn.getAttribute("data-lang-btn") === lang;
      btn.className = `lang-btn cursor-pointer flex items-center gap-1 px-3 py-1.5 rounded-full text-sm font-medium shadow-md transition ${
        isActive
          ? "bg-purple-700 text-white"
          : "bg-white text-purple-700 hover:bg-purple-50"
      }`;
    });
  }

  document.querySelectorAll("[data-lang-btn]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const lang = btn.getAttribute("data-lang-btn");
      localStorage.setItem("lang", lang);
      applyLang(lang);
    });
  });

  applyLang(getLang());
</script>
