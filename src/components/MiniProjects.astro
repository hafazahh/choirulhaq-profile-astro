---
interface MiniProject {
  titleKey: string;
  descKey: string;
  techStack: string[];
  link: string;
  badge: string;
  badgeColor: string;
  fallbackTitle: string;
  fallbackDesc: string;
}

const miniProjects: MiniProject[] = [
  {
    titleKey: "miniproject.crudTestopencode.title",
    descKey: "miniproject.crudTestopencode.desc",
    techStack: ["Python", "Flask", "SQLite", "Jinja2", "Render", "Cloudflare"],
    link: "https://crud.choirulhaq.com",
    badge: "CRUD",
    badgeColor: "bg-indigo-600",
    fallbackTitle: "CRUD Testopencode",
    fallbackDesc:
      "Aplikasi web CRUD Item dengan Python (Flask) + SQLite + Auth System + Role-Based Access Control. Fitur: login/logout, user management, role management dengan permission checkboxes, CRUD items/kategori/pelanggan, auto-deploy ke Render + Cloudflare.",
  },
  {
    titleKey: "miniproject.computerVision.title",
    descKey: "miniproject.computerVision.desc",
    techStack: ["Python", "Streamlit", "OpenCV", "EasyOCR", "PyTorch", "Cloudflare"],
    link: "https://vision.choirulhaq.com",
    badge: "CV",
    badgeColor: "bg-purple-600",
    fallbackTitle: "Computer Vision — ANPR",
    fallbackDesc:
      "Pemanfaatan teknologi AI untuk pengenalan objek: implementasi pengenalan nomor plat kendaraan (ANPR) yang dapat diintegrasikan dengan data member, sistem pembayaran, dan kontrol akses berbasis AI.",
  },
  {
    titleKey: "miniproject.indonesiaEconomy.title",
    descKey: "miniproject.indonesiaEconomy.desc",
    techStack: ["Python", "Flask", "Plotly", "APScheduler", "SQLite", "World Bank API"],
    link: "https://inthiseconomy.choirulhaq.com",
    badge: "ECON",
    badgeColor: "bg-emerald-600",
    fallbackTitle: "Indonesia Economic Dashboard",
    fallbackDesc:
      "Dashboard makro ekonomi Indonesia: Pertumbuhan PDB, Inflasi, dan Neraca Perdagangan. Data ditarik otomatis setiap 6 jam langsung dari World Bank API — sumber resmi yang dapat dikutip. Dilengkapi grafik tren 5 tahun, proyeksi IMF, insight singkat, dan unduh CSV. Dibuat untuk membantu akademisi (mahasiswa & dosen) memperoleh data akurat untuk tugas dan penelitian, serta membantu pebisnis membaca arah ekonomi untuk pengambilan keputusan.",
  },
];
---

<section id="mini-project" class="py-20 px-4 bg-purple-50">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-purple-900" data-i18n="miniproject.title">
      Mini Project
    </h2>
    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
      {miniProjects.map((project) => (
        <li
          class="bg-white p-6 rounded-xl shadow-md hover:shadow-lg transition border border-gray-100 flex flex-col"
        >
          <div class={`w-16 h-16 mb-4 rounded-lg ${project.badgeColor} flex items-center justify-center flex-shrink-0`}>
            <span class="text-white font-bold text-lg">{project.badge}</span>
          </div>
          <h3 class="text-xl font-bold mb-2 text-purple-800" data-i18n={project.titleKey}>
            {project.fallbackTitle}
          </h3>
          <p class="text-gray-600 text-sm mb-4 flex-1" data-i18n={project.descKey}>
            {project.fallbackDesc}
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            {project.techStack.map((tech) => (
              <span
                class="bg-purple-100 text-purple-700 text-xs font-medium px-2 py-1 rounded"
              >
                {tech}
              </span>
            ))}
          </div>
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-center bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-purple-800 transition"
            data-i18n="miniproject.view"
          >
            Lihat Project →
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
